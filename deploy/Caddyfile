{
	# The app shares this network namespace (compose network_mode); a reachable
	# admin API on :2019 would let it rewrite the proxy. Restart to reconfigure.
	admin off
}

{$GRAPHICLE_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 32MB
	}
	reverse_proxy 127.0.0.1:8854 {
		header_up Host {$GRAPHICLE_DOMAIN}
	}
}
