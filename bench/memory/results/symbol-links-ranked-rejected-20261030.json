  "candidate_patch_sha256": "9083e569dfb7f7d737e30c948dd30fae2703c3ce07f5edaa4092740247896f35",
  "candidate_patch_for_reproduction_only": "diff --git a/crates/graphicle/src/query.rs b/crates/graphicle/src/query.rs\nindex 1970f51..6adff8f 100644\n--- a/crates/graphicle/src/query.rs\n+++ b/crates/graphicle/src/query.rs\n@@ -876,6 +876,32 @@ pub fn rerank_order(scores: &[f64], blend: bool) -> Vec<usize> {\n     order\n }\n \n+/// A code link proposes a memory; the query's existing retrieval arms decide\n+/// whether to include it. Call only with the authorized, current rows returned\n+/// by symbol_links::lift. Keep the original records and link provenance.\n+fn rank_linked_memories(request: &Value, memories: Vec<Value>) -> Result<Vec<Value>> {\n+    if memories.is_empty() {\n+        return Ok(memories);\n+    }\n+    let mut selection = json!({\"rows\":memories,\"limit\":crate::symbol_links::MEMORY_LIMIT});\n+    for field in [\n+        \"scope\", \"question\", \"needs\", \"mode\", \"stem\", \"speaker\", \"query_variants\",\n+        \"arm_weights\", \"rrf_k\", \"key_expansion\", \"rankings\",\n+    ] {\n+        if let Some(value) = request.get(field) {\n+            selection[field] = value.clone();\n+        }\n+    }\n+    let selected = native(\"rank\", selection)?;\n+    let by_id: BTreeMap<&str, &Value> = memories.iter().map(|m| (s(m, \"identity\"), m)).collect();\n+    Ok(selected[\"memories\"]\n+        .as_array()\n+        .into_iter()\n+        .flatten()\n+        .filter_map(|id| by_id.get(id.as_str()?).map(|row| (*row).clone()))\n+        .collect())\n+}\n+\n /// Candidate order fusing the cross-encoder's order with the fused order,\n /// 0.7/(60 + CE rank) + 0.3/(60 + fused rank) (SmartSearch, arXiv\n /// 2603.15599 \u00a73.5; index = fused rank). Ties keep fused order.\n@@ -1753,8 +1779,14 @@ fn context_impl(\n         ) {\n             Ok(lifted) => {\n                 candidates.extend(lifted.windows);\n-                linked_memories = lifted.memories;\n+                let offered = lifted.memories.len();\n+                linked_memories = rank_linked_memories(&rank_request, lifted.memories)?;\n                 symbol_links_report = lifted.report;\n+                if offered > 0 {\n+                    symbol_links_report[\"candidate_memories\"] = json!(offered);\n+                    symbol_links_report[\"lifted_memories\"] = json!(linked_memories.len());\n+                    symbol_links_report[\"withheld_by_query\"] = json!(offered - linked_memories.len());\n+                }\n             }\n             Err(error) => symbol_links_report = json!({\"status\":\"error\",\"error\":error.message}),\n         }\n@@ -2648,6 +2680,32 @@ impl Store {\n mod tests {\n     use super::{rerank_order, rerank_rrf_order};\n \n+    #[test]\n+    fn linked_memory_selection_preserves_records_and_requires_query_evidence() {\n+        use serde_json::json;\n+        let relevant = json!({\"identity\":\"memory:a\",\"origin\":\"memory:a\",\"kind\":\"memory\",\n+            \"title\":\"Lease ceiling\",\"text\":\"The lease expires after one minute.\",\n+            \"memory\":{\"id\":\"a\",\"via\":\"link\",\"link\":{\"stable_id\":\"symbol-a\"}}});\n+        let unrelated = json!({\"identity\":\"memory:b\",\"origin\":\"memory:b\",\"kind\":\"memory\",\n+            \"title\":\"Audit archive\",\"text\":\"Retain receipts for seven years.\",\n+            \"memory\":{\"id\":\"b\",\"via\":\"link\",\"link\":{\"stable_id\":\"symbol-a\"}}});\n+        let request = json!({\"scope\":\"test-linked-memory\",\"question\":\"When does the lease expire?\"});\n+        let picked = super::rank_linked_memories(&request, vec![unrelated, relevant.clone()]).unwrap();\n+        assert_eq!(picked, vec![relevant]);\n+        assert!(super::rank_linked_memories(&request, vec![]).unwrap().is_empty());\n+    }\n+\n+    #[test]\n+    fn linked_memory_selection_keeps_an_existing_semantic_match() {\n+        use serde_json::json;\n+        let memory = json!({\"identity\":\"memory:a\",\"origin\":\"memory:a\",\"kind\":\"memory\",\n+            \"title\":\"Quokka ledger\",\"text\":\"Keep the quokka ledger frozen.\",\n+            \"memory\":{\"id\":\"a\",\"via\":\"link\"}});\n+        let request = json!({\"scope\":\"test-linked-semantic\",\"question\":\"Why does alpha return one?\",\n+            \"rankings\":{\"semantic\":[\"unknown-id\",\"memory:a\"]}});\n+        assert_eq!(super::rank_linked_memories(&request, vec![memory.clone()]).unwrap(), vec![memory]);\n+    }\n+\n     #[test]\n     fn a_question_names_tests_by_a_test_file_or_identifier() {\n         use super::question_names_tests as names;\n",
