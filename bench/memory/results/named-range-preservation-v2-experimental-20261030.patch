+/// Full anchored ranges for code symbols explicitly named in the query.
+/// Uses only hits already authorized and freshness-checked by the graph arm.
+/// Reuses the arm's bounded synthetic citation construction; no new graph read.
+pub fn named_windows(arm: &Arm, question: &str, documents: &[Value]) -> Vec<Value> {
+    let named = crate::identifier_arm::named(question);
+    let hits = arm.hits.iter().filter(|hit| {
+        let Some(attributes) = hit.facts.as_object() else { return false; };
+        if !code_symbol(attributes) { return false; }
+        let Some(symbol) = crate::identifier_route::symbol_name(attributes) else { return false; };
+        named.names.iter().any(|name| {
+            let dotted = name.replace("::", ".").replace("->", ".").replace('#', ".");
+            symbol == dotted || symbol.strip_suffix(&dotted).is_some_and(|head| head.ends_with('.'))
+        })
+    }).cloned().collect();
+    let selected = Arm { hits, diagnostics: Value::Null };
+    let (_, _, mut windows) = fuse(&selected, &[], documents);
+    for window in &mut windows {
+        window["source"]["keep_whole"] = json!(true);
     }
+    windows
 }
 
